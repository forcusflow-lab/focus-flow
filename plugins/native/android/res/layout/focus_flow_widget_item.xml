<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/focus_flow_widget_item_root"
  android:layout_width="match_parent"
  android:layout_height="48dp"
  android:minHeight="48dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <View
      android:id="@+id/focus_flow_widget_item_required_rail"
      android:layout_width="3dp"
      android:layout_height="match_parent" />
    <FrameLayout
      android:id="@+id/focus_flow_widget_item_action"
      android:layout_width="48dp"
      android:layout_height="match_parent"
      android:gravity="center">
      <ImageView
        android:id="@+id/focus_flow_widget_item_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription=""
        android:scaleType="center" />
    </FrameLayout>
    <LinearLayout
      android:id="@+id/focus_flow_widget_item_content"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingEnd="8dp">
      <TextView
        android:id="@+id/focus_flow_widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/focus_flow_widget_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/focus_flow_widget_badge_mist_light_100"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textSize="10sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
  <View
    android:id="@+id/focus_flow_widget_item_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="51dp" />
</FrameLayout>
